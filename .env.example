# ── AI engine (pick one; Gemini is used first when both are set) ─────────────
# Google Gemini: free tier. Research reads real pages about each app (Wikipedia, its site, GitHub, engineering
# posts) with Gemini's URL tool. Get a key at https://aistudio.google.com
GEMINI_API_KEY=
# Models are rotated when one hits its free per-minute limit (each model has its own quota)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_RESEARCH_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# GEMINI_FAST_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash
# GEMINI_RPM=5
# Google Search grounding needs a billing-enabled key (free keys are refused)
# GEMINI_GOOGLE_SEARCH=on

# Anthropic Claude (paid): https://console.anthropic.com
# Server-side (API routes). Never prefix with EXPO_PUBLIC_.
ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini   # or claude, to force one when both keys are set
# Optional overrides
# TEARDOWN_MODEL=claude-opus-5
# TEARDOWN_EFFORT=medium

# Teardown is free by default. Set to true to turn the Teardown Pro paywall back on.
# EXPO_PUBLIC_PAYWALL_ENABLED=true

# RevenueCat (client). A Test Store key works in Expo Go and on web.
EXPO_PUBLIC_REVENUECAT_API_KEY=
# Store builds can use per-platform keys instead:
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=pro

# When the app runs outside the dev server (store builds), point it at your deployed API
# EXPO_PUBLIC_API_URL=https://teardown.expo.app
