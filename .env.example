# Server-side (API routes). Never prefix with EXPO_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional overrides
# TEARDOWN_MODEL=claude-opus-5
# TEARDOWN_EFFORT=medium

# Teardown is free by default. Set to true to turn the Teardown Pro paywall back on.
# EXPO_PUBLIC_PAYWALL_ENABLED=true

# RevenueCat (client). A Test Store key works in Expo Go and on web.
EXPO_PUBLIC_REVENUECAT_API_KEY=
# Store builds can use per-platform keys instead:
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=pro

# When the app runs outside the dev server (store builds), point it at your deployed API
# EXPO_PUBLIC_API_URL=https://teardown.expo.app
